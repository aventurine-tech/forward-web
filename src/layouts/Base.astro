---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DemoGuard from '../components/DemoGuard.astro';
import { isPreview, asset, company, defaultLocale, locales, pages, path, stripLocale, t, type Locale } from '../i18n';
import { ogSlug } from '../og/cards';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Keep the page out of search results (thank-you and error pages). */
  noindex?: boolean;
}
const { locale, title, description, noindex = false } = Astro.props;
const d = t(locale);
const pageTitle = title ? `${title} | Forward International` : d.meta.title;
const pageDescription = description ?? d.meta.description;
const basePath = stripLocale(Astro.url.pathname);
const site = Astro.site ?? new URL('https://www.forward.md');
// Inter is served from the site itself (variable font, SIL Open Font License), so no
// request goes to Google and nothing blocks the first paint.
const fontFaces = [
  ['latin', 'U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD'],
  ['latin-ext', 'U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF'],
  ['cyrillic', 'U+0301,U+0400-045F,U+0490-0491,U+04B0-04B1,U+2116'],
  ['cyrillic-ext', 'U+0460-052F,U+1C80-1C8A,U+20B4,U+2DE0-2DFF,U+A640-A69F,U+FE2E-FE2F'],
]
  .map(
    ([file, range]) =>
      `@font-face{font-family:'Inter';font-style:normal;font-weight:100 900;font-display:swap;src:url(${asset(`fonts/inter-${file}.woff2`)}) format('woff2');unicode-range:${range}}`,
  )
  .join('');

// Previews (GitHub Pages, Netlify, or any build with PREVIEW=1) stay out of search results so
// they never compete with forward.md.
const preview = isPreview(site);
// Each page has its own share picture per language (src/pages/og/); pages without one
// (thank-you, 404) fall back to the plain logo card.
const ogImage = (pages as readonly string[]).includes(basePath)
  ? asset(`og/${locale}/${ogSlug(basePath)}.jpg`)
  : asset('og.jpg');
const ogLocale = { ro: 'ro_MD', en: 'en_US', ru: 'ru_RU' }[locale];
const org = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  legalName: company.legalName,
  url: new URL(path(defaultLocale), site).href,
  logo: new URL(asset('favicon.svg'), site).href,
  foundingDate: '1994-10-06',
  email: company.email,
  telephone: company.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'șos. Muncești 801A',
    postalCode: 'MD-2029',
    addressLocality: 'Chișinău',
    addressCountry: 'MD',
  },
  sameAs: [company.instagram, company.facebook, company.linkedin],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    {(noindex || preview) && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(path(locale, basePath), site)} />
    {locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(path(l, basePath), site)} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(path(defaultLocale, basePath), site)} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Forward International" />
    <meta property="og:url" content={new URL(path(locale, basePath), site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={new URL(ogImage, site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:image" content={new URL(ogImage, site)} />
    <link rel="preload" href={asset('fonts/inter-latin.woff2')} as="font" type="font/woff2" crossorigin />
    {locale === 'ru' && <link rel="preload" href={asset('fonts/inter-cyrillic.woff2')} as="font" type="font/woff2" crossorigin />}
    <style is:inline set:html={fontFaces}></style>
    <script type="application/ld+json" set:html={JSON.stringify(org)} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <DemoGuard locale={locale} />
    <Header locale={locale} />
    <main>
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { threshold: 0.12, rootMargin: '0px 0px -40px 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
