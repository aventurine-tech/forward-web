---
import Logo from './Logo.astro';
import { locales, localeNames, path, stripLocale, t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const current = stripLocale(Astro.url.pathname).replace(/\/$/, '') || '/';

const links = [
  { href: '/services', label: d.nav.services },
  { href: '/brands', label: d.nav.brands },
  { href: '/about', label: d.nav.about },
  { href: '/news', label: d.nav.news },
  { href: '/contact', label: d.nav.contact },
];
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={path(locale)} class="site-header__brand" aria-label="Forward International">
      <Logo height={40} />
    </a>

    <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav" data-nav-toggle>
      <span class="visually-hidden">{d.nav.menu}</span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
      <span class="nav-toggle__bar"></span>
    </button>

    <nav id="site-nav" class="site-nav" data-nav>
      <ul class="site-nav__links">
        {
          links.map((l) => (
            <li>
              <a href={path(locale, l.href)} aria-current={current === l.href ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="site-nav__end">
        <ul class="lang" aria-label={d.nav.language}>
          {
            locales.map((l) => (
              <li>
                <a
                  href={path(l, current)}
                  hreflang={l}
                  lang={l}
                  title={localeNames[l]}
                  aria-current={l === locale ? 'true' : undefined}
                >
                  {l.toUpperCase()}
                </a>
              </li>
            ))
          }
        </ul>
        <a class="btn btn--primary site-nav__cta" href={path(locale, '/contact')}>{d.nav.cta}</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: saturate(1.6) blur(14px);
    -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s, box-shadow 0.25s;
  }
  .site-header.is-scrolled {
    border-color: var(--line);
    box-shadow: 0 6px 24px -18px rgba(12, 33, 53, 0.4);
  }
  .site-header__inner {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .site-header__brand {
    display: inline-flex;
    text-decoration: none;
  }
  .site-nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: 6px;
  }
  .site-nav__links a {
    display: block;
    color: var(--ink);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.98rem;
    padding: 8px 14px;
    border-radius: 999px;
    white-space: nowrap;
    transition: background 0.2s, color 0.2s;
  }
  .site-nav__links a:hover {
    background: var(--bg-soft);
  }
  .site-nav__links a[aria-current='page'] {
    color: var(--blue-600);
    background: var(--blue-50);
  }
  .site-nav__end {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  .lang {
    gap: 2px !important;
    padding: 3px !important;
    background: var(--bg-soft) !important;
    border-radius: 999px;
  }
  .lang a {
    display: block;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 5px 9px;
    border-radius: 999px;
  }
  .lang a[aria-current='true'] {
    color: var(--ink);
    background: #fff;
    box-shadow: 0 1px 3px rgba(12, 33, 53, 0.12);
  }
  .site-nav__cta {
    padding: 11px 20px;
    font-size: 0.95rem;
    white-space: nowrap;
  }
  .nav-toggle {
    display: none;
    background: none;
    border: 0;
    padding: 8px;
    cursor: pointer;
    color: var(--ink);
  }
  .nav-toggle__bar {
    display: block;
    width: 24px;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.25s var(--ease), opacity 0.2s;
  }

  @media (max-width: 1180px) {
    .nav-toggle {
      display: grid;
      place-content: center;
      gap: 5px;
      width: 44px;
      height: 44px;
      margin-right: -10px;
    }
    .site-nav {
      position: fixed;
      inset: var(--header-h) 0 auto;
      background: #fff;
      flex-direction: column;
      align-items: stretch;
      gap: 18px;
      padding: 12px 16px 24px;
      border-bottom: 1px solid var(--line);
      box-shadow: 0 24px 40px -24px rgba(12, 33, 53, 0.35);
      display: none;
      max-height: calc(100svh - var(--header-h));
      overflow-y: auto;
    }
    .site-nav.is-open {
      display: flex;
    }
    .site-nav ul.site-nav__links {
      flex-direction: column;
      gap: 0;
    }
    .site-nav__links a {
      padding: 14px 4px;
      border-radius: 0;
      border-bottom: 1px solid var(--line);
      font-size: 1.05rem;
    }
    .site-nav__links a:hover,
    .site-nav__links a[aria-current='page'] {
      background: none;
    }
    .site-nav__end {
      justify-content: space-between;
    }
    .lang a {
      min-width: 44px;
      min-height: 36px;
      display: grid;
      place-items: center;
      font-size: 0.9rem;
    }
    :global(.nav-open) .site-header {
      background: #fff;
    }
    .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(2) {
      transform: translateY(7px) rotate(45deg);
    }
    .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(3) {
      opacity: 0;
    }
    .nav-toggle[aria-expanded='true'] .nav-toggle__bar:nth-child(4) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
  @media (max-width: 420px) {
    .site-nav__cta {
      padding: 11px 16px;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');

  const update = () => header?.classList.toggle('is-scrolled', window.scrollY > 8);
  update();
  window.addEventListener('scroll', update, { passive: true });

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
    document.documentElement.classList.toggle('nav-open', open);
  });
</script>
