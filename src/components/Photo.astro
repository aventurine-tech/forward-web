---
// A photo from public/photos/ served as WebP (800px and full size) with a JPEG fallback.
import { asset } from '../i18n';

interface Props {
  name: 'city' | 'warehouse' | 'fleet';
  alt: string;
  class?: string;
  eager?: boolean;
  /** How wide the photo is shown, so phones can pick the 800px file. */
  sizes?: string;
}
const dims = { city: [1903, 800], warehouse: [1600, 801], fleet: [1600, 646] } as const;
const { name, alt, class: cls, eager = false, sizes = '(max-width: 900px) 100vw, 50vw' } = Astro.props;
const [w, h] = dims[name];
---

<picture class:list={['photo', cls]}>
  <source
    srcset={`${asset(`photos/${name}-800.webp`)} 800w, ${asset(`photos/${name}.webp`)} ${w}w`}
    sizes={sizes}
    type="image/webp"
  />
  <img
    src={asset(`photos/${name}.jpg`)}
    alt={alt}
    width={w}
    height={h}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    fetchpriority={eager ? 'high' : undefined}
  />
</picture>
