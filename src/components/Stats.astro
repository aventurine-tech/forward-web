---
import { t, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const stats = t(locale).stats;
---

<section class="stats" aria-label="Forward International" data-stats>
  <div class="container">
    <ul class="stats__grid">
      {
        stats.map((s, i) => (
          <li class="reveal" style={`--delay:${i * 0.06}s`}>
            <strong>
              <span aria-hidden="true" data-count>{s.value}</span>
              <span class="visually-hidden">{s.value}</span>
            </strong>
            <span>{s.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  // Count each figure up from zero the first time the band scrolls into view. The real
  // figure is in the HTML (and read out by screen readers), so without JavaScript or with
  // reduced motion the numbers simply show as they are.
  const DURATION = 1600;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // "~2.000", "3 000+", "30+": keep the text around the number and its thousands separator.
  const parse = (text: string) => {
    const m = text.match(/^(\D*)(\d{1,3}(?:([.,\s\u00a0\u202f])\d{3})*|\d+)(\D*)$/);
    if (!m) return null;
    const sep = m[3] ?? '';
    return { prefix: m[1], target: Number(m[2].replace(/\D/g, '')), sep, suffix: m[4] };
  };
  const format = (n: number, sep: string) =>
    sep ? String(n).replace(/\B(?=(\d{3})+(?!\d))/g, sep) : String(n);
  const ease = (t: number) => 1 - Math.pow(1 - t, 3);

  const run = (band: HTMLElement) => {
    band.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const final = el.textContent ?? '';
      const p = parse(final.trim());
      if (!p || p.target < 2) return;
      const start = performance.now();
      const tick = (now: number) => {
        const t = Math.min((now - start) / DURATION, 1);
        el.textContent = t < 1 ? p.prefix + format(Math.round(p.target * ease(t)), p.sep) + p.suffix : final;
        if (t < 1) requestAnimationFrame(tick);
      };
      el.textContent = p.prefix + '0' + p.suffix;
      requestAnimationFrame(tick);
    });
  };

  const bands = document.querySelectorAll<HTMLElement>('[data-stats]');
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            io.unobserve(e.target);
            run(e.target as HTMLElement);
          }
        }
      },
      { threshold: 0.35 },
    );
    bands.forEach((b) => io.observe(b));
  }
</script>

<style>
  .stats {
    background: var(--ink);
    color: #fff;
    padding-block: clamp(44px, 6vw, 72px);
    position: relative;
    overflow: hidden;
  }
  .stats::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(600px 300px at 10% 0%, rgba(40, 142, 214, 0.35), transparent 70%),
      radial-gradient(500px 300px at 95% 100%, rgba(40, 142, 214, 0.22), transparent 70%);
  }
  .stats__grid {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 24px;
  }
  .stats li {
    display: grid;
    gap: 6px;
    align-content: start;
    padding-left: 18px;
    border-left: 2px solid rgba(40, 142, 214, 0.55);
  }
  .stats strong {
    font-size: clamp(1.9rem, 3.2vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .stats strong span {
    color: inherit;
    font-size: inherit;
    line-height: inherit;
  }
  .stats strong [data-count] {
    font-variant-numeric: tabular-nums;
  }
  .stats li > span {
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.95rem;
    line-height: 1.35;
  }
  @media (max-width: 1000px) {
    .stats__grid {
      grid-template-columns: repeat(3, 1fr);
      row-gap: 36px;
    }
  }
  @media (max-width: 520px) {
    .stats__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
