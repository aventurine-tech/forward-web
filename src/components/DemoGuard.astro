---
// DEMO=1 (set in netlify.toml) shows a strip marking the site as a design proposal.
// The password itself is checked on Netlify's servers by netlify/edge-functions/demo-gate.js.
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const demo = Boolean(process.env.DEMO);
const strip = {
  ro: 'Propunere de design realizată de Radu G. Nu poate fi copiată sau reutilizată fără acordul prealabil.',
  en: 'Design proposal by Radu G. Not to be copied or reused without prior consent.',
  ru: 'Дизайн-предложение от Radu G. Копирование и использование без предварительного согласия запрещено.',
}[locale];
---

{demo && <div class="demo-strip" role="note">{strip}</div>}

<style>
  .demo-strip {
    position: relative;
    z-index: 60;
    padding: 8px 16px;
    background: #0b1f33;
    color: #fff;
    font-size: 0.82rem;
    font-weight: 600;
    text-align: center;
  }
</style>
