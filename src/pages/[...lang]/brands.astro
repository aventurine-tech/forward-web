---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { brands } from '../../data/brands';
import { asset, localePaths, t, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const b = d.brandsPage;
---

<Base locale={locale} title={b.title} description={b.lead}>
  <PageHero eyebrow={d.home.brandsEyebrow} title={b.title} lead={b.lead} />

  <section class="section">
    <div class="container">
      <h2 class="sub">{b.partnersTitle}</h2>
      <ul class="logos">
        {
          brands.map((br, i) => (
            <li class="reveal" style={`--delay:${(i % 6) * 0.04}s`}>
              <img src={asset(br.logo)} alt="" loading="lazy" decoding="async" />
              <span>{br.name}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container own">
      <div>
        <h2>{b.ownTitle}</h2>
        <p class="lead">{b.ownText}</p>
      </div>
      <ul class="own__list">
        {b.own.map((name) => <li class="reveal">{name}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container ask reveal">
      <h2>{b.askTitle}</h2>
      <p class="lead">{b.askText}</p>
    </div>
  </section>

  <CtaBand locale={locale} />
</Base>

<style>
  .sub {
    font-size: 1.5rem;
    margin-bottom: 28px;
  }
  .logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr));
    gap: 16px;
  }
  .logos li {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 12px;
    height: 170px;
    padding: 22px 18px 14px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    text-align: center;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s;
  }
  .logos li:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--blue-100);
  }
  .logos img {
    width: 100%;
    height: 100%;
    max-height: 96px;
    object-fit: contain;
    align-self: center;
  }
  .logos span {
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--muted);
  }
  .own {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .own__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .own__list li {
    display: grid;
    place-items: center;
    min-height: 140px;
    border-radius: 20px;
    background: linear-gradient(135deg, var(--blue), var(--blue-700));
    color: #fff;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .ask {
    max-width: 760px;
    text-align: center;
  }
  .ask .lead {
    margin: 0;
  }
  @media (max-width: 760px) {
    .own {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .logos {
      grid-template-columns: 1fr 1fr;
    }
    .logos li {
      height: 140px;
    }
  }
</style>
