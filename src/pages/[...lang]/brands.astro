---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import { brands, categories } from '../../data/brands';
import { asset, localePaths, t, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const b = d.brandsPage;
---

<Base locale={locale} title={b.title} description={b.lead}>
  <PageHero eyebrow={d.home.brandsEyebrow} title={b.title} lead={b.lead} />

  <section class="section">
    <div class="container">
      <div class="head">
        <h2 class="sub">{b.partnersTitle}</h2>
        <div class="filter" role="group" aria-label={b.filterLabel} data-filter>
          <button type="button" aria-pressed="true" data-cat="all">{b.filterAll} <span>{brands.length}</span></button>
          {
            categories.map((cat) => (
              <button type="button" aria-pressed="false" data-cat={cat}>
                {b.categories[cat]} <span>{brands.filter((br) => br.category === cat).length}</span>
              </button>
            ))
          }
        </div>
      </div>
      <ul class="logos" data-logos>
        {
          brands.map((br, i) => (
            <li class="reveal" style={`--delay:${(i % 6) * 0.04}s`} data-cat={br.category}>
              <img src={asset(br.logo)} alt="" loading="lazy" decoding="async" />
              <span>{br.name}</span>
              <small>{b.categories[br.category]}</small>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container own">
      <div>
        <h2>{b.ownTitle}</h2>
        <p class="lead">{b.ownText}</p>
      </div>
      <ul class="own__list">
        {b.own.map((name) => <li class="reveal">{name}</li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container ask reveal">
      <h2>{b.askTitle}</h2>
      <p class="lead">{b.askText}</p>
    </div>
  </section>

  <CtaBand locale={locale} />

  <script>
    const filter = document.querySelector<HTMLElement>('[data-filter]');
    const items = document.querySelectorAll<HTMLElement>('[data-logos] li');
    filter?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('button[data-cat]');
      if (!btn) return;
      const cat = btn.dataset.cat;
      filter.querySelectorAll('button').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((li) => {
        li.hidden = cat !== 'all' && li.dataset.cat !== cat;
        li.classList.add('is-visible');
      });
    });
  </script>
</Base>

<style>
  .head {
    display: grid;
    gap: 18px;
    margin-bottom: 28px;
  }
  .sub {
    font-size: 1.5rem;
    margin: 0;
  }
  .filter {
    display: none;
    flex-wrap: wrap;
    gap: 8px;
  }
  :global(.js) .filter {
    display: flex;
  }
  .filter button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font: inherit;
    font-size: 0.92rem;
    font-weight: 600;
    padding: 9px 16px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .filter button span {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--muted);
  }
  .filter button:hover {
    border-color: var(--blue-100);
    background: var(--blue-50);
  }
  .filter button[aria-pressed='true'] {
    background: var(--ink);
    border-color: var(--ink);
    color: #fff;
  }
  .filter button[aria-pressed='true'] span {
    color: rgba(255, 255, 255, 0.7);
  }
  .filter button:focus-visible {
    outline: 3px solid var(--blue);
    outline-offset: 2px;
  }
  .logos li[hidden] {
    display: none;
  }
  .logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 170px), 1fr));
    gap: 16px;
  }
  .logos li {
    display: grid;
    grid-template-rows: 1fr auto auto;
    gap: 12px;
    height: 186px;
    padding: 22px 18px 14px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 18px;
    text-align: center;
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease), border-color 0.3s;
  }
  .logos li:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: var(--blue-100);
  }
  .logos img {
    width: 100%;
    height: 100%;
    max-height: 96px;
    object-fit: contain;
    align-self: center;
  }
  .logos span {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--ink);
  }
  .logos small {
    margin-top: -8px;
    font-size: 0.76rem;
    color: var(--muted);
  }
  .own {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }
  .own__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .own__list li {
    display: grid;
    place-items: center;
    min-height: 140px;
    border-radius: 20px;
    background: linear-gradient(135deg, var(--blue), var(--blue-700));
    color: #fff;
    font-size: clamp(1.3rem, 2.4vw, 1.8rem);
    font-weight: 800;
    letter-spacing: -0.02em;
  }
  .ask {
    max-width: 760px;
    text-align: center;
  }
  .ask .lead {
    margin: 0;
  }
  @media (max-width: 760px) {
    .own {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 420px) {
    .logos {
      grid-template-columns: 1fr 1fr;
    }
    .logos li {
      height: 140px;
    }
  }
</style>
