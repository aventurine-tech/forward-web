---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import { company, localePaths, path, t, tel, type Locale } from '../../i18n';

export const getStaticPaths = localePaths;
const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const c = d.contact;

// The form goes live once the deploy sets the worker URL and Turnstile site key
// (see form-worker/ and README). Until then it just shows the thank-you page.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT as string | undefined;
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const live = Boolean(endpoint && siteKey);
const { lat, lon } = company.geo;
const directions = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lon}`;
---

<Base locale={locale} title={c.title} description={c.lead}>
  <PageHero eyebrow={d.nav.contact} title={c.title} lead={c.lead} />

  <section class="section">
    <div class="container contact">
      <div class="contact__info">
        <div class="info reveal">
          <span class="info__icon"><Icon name="pin" /></span>
          <div>
            <h3>{c.officeTitle}</h3>
            <p>{company.address[locale].map((line) => (<>{line}<br /></>))}</p>
            <a class="link-arrow" href={directions} target="_blank" rel="noopener">{c.directions}</a>
          </div>
        </div>
        <div class="info reveal">
          <span class="info__icon"><Icon name="phone" /></span>
          <div>
            <h3>{c.phoneTitle}</h3>
            <p>
              <a href={tel(company.phone)}>{company.phone}</a><br />
              <span class="muted">{c.fax}: {company.fax}</span>
            </p>
          </div>
        </div>
        <div class="info reveal">
          <span class="info__icon"><Icon name="mail" /></span>
          <div>
            <h3>{c.emailTitle}</h3>
            <p><a href={`mailto:${company.email}`}>{company.email}</a></p>
          </div>
        </div>
        <div class="info reveal">
          <span class="info__icon"><Icon name="doc" /></span>
          <div>
            <h3>{c.legalTitle}</h3>
            <dl>
              <dt>{c.legalName}</dt><dd>{company.legalName}</dd>
              <dt>{c.idno}</dt><dd>{company.idno}</dd>
              <dt>{c.registered}</dt><dd>{c.registeredDate}</dd>
            </dl>
          </div>
        </div>
        <div class="social reveal">
          <span>{c.followTitle}</span>
          <a href={company.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" size={20} /></a>
          <a href={company.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" size={20} /></a>
          <a href={company.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn"><Icon name="linkedin" size={20} /></a>
        </div>
      </div>

      <form
        id="form"
        class="form reveal"
        action={live ? endpoint : path(locale, '/thanks')}
        method={live ? 'post' : 'get'}
      >
        <h2>{c.formTitle}</h2>
        <input type="hidden" name="lang" value={locale} />
        <label class="hp" aria-hidden="true">
          Website
          <input name="website" tabindex="-1" autocomplete="off" />
        </label>
        <div class="form__row">
          <label>
            {c.firstName} *
            <input name="firstName" autocomplete="given-name" required />
          </label>
          <label>
            {c.lastName} *
            <input name="lastName" autocomplete="family-name" required />
          </label>
        </div>
        <div class="form__row">
          <label>
            {c.email} *
            <input name="email" type="email" autocomplete="email" required />
          </label>
          <label>
            {c.company}
            <input name="company" autocomplete="organization" />
          </label>
        </div>
        <label>
          {c.message} *
          <textarea name="message" rows="6" maxlength="5000" required></textarea>
        </label>
        {live && <div class="cf-turnstile" data-sitekey={siteKey} data-language={locale} data-size="flexible"></div>}
        <p class="form__error" role="alert" data-form-error hidden></p>
        <button class="btn btn--primary" type="submit">
          {c.send}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
        <p class="form__note">{c.formNote}</p>
      </form>
    </div>
  </section>

  <section class="container map" aria-label={c.officeTitle}>
    <iframe
      title="Map"
      loading="lazy"
      src={`https://www.openstreetmap.org/export/embed.html?bbox=${lon - 0.02}%2C${lat - 0.009}%2C${lon + 0.02}%2C${lat + 0.009}&layer=mapnik&marker=${lat}%2C${lon}`}
    ></iframe>
  </section>
  {live && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <script is:inline define:vars={{ errors: c.formErrors }}>
    // The form worker redirects back with ?form=<reason> when a message could not be sent.
    var reason = new URLSearchParams(location.search).get('form');
    var box = document.querySelector('[data-form-error]');
    if (reason && box) {
      box.textContent = errors[reason] || errors.error;
      box.hidden = false;
    }
  </script>
</Base>

<style>
  #form {
    scroll-margin-top: calc(var(--header-h) + 24px);
  }
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr);
    gap: clamp(28px, 5vw, 56px);
    align-items: start;
  }
  .contact__info {
    display: grid;
    gap: 14px;
  }
  .info {
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    padding: 22px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: #fff;
  }
  .info__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 14px;
    background: var(--blue-50);
    color: var(--blue);
  }
  .info h3 {
    font-size: 1.02rem;
    margin-bottom: 6px;
  }
  .info p {
    margin: 0 0 8px;
  }
  .info p:last-child {
    margin: 0;
  }
  .info a:not(.link-arrow) {
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
  }
  .info a:not(.link-arrow):hover {
    color: var(--blue-600);
  }
  .muted {
    color: var(--muted);
    font-size: 0.95rem;
  }
  .info dl {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 14px;
    font-size: 0.95rem;
  }
  .info dt {
    color: var(--muted);
  }
  .info dd {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .social {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 4px;
    font-weight: 600;
    color: var(--muted);
  }
  .social span {
    margin-right: 6px;
  }
  .social a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1px solid var(--line);
    color: var(--ink);
    transition: background 0.2s, color 0.2s, border-color 0.2s;
  }
  .social a:hover {
    background: var(--blue);
    border-color: var(--blue);
    color: #fff;
  }
  .form {
    display: grid;
    gap: 18px;
    padding: clamp(24px, 4vw, 40px);
    border-radius: 24px;
    background: var(--bg-soft);
    border: 1px solid var(--line);
  }
  .form h2 {
    font-size: 1.7rem;
    margin: 0 0 4px;
  }
  .form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .form label {
    display: grid;
    gap: 6px;
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--ink);
  }
  .form input,
  .form textarea {
    font: inherit;
    font-weight: 400;
    padding: 13px 15px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    color: var(--text);
    width: 100%;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form input:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--blue);
    box-shadow: 0 0 0 4px rgba(40, 142, 214, 0.15);
  }
  .form .btn {
    justify-self: start;
  }
  .form__note {
    font-size: 0.85rem;
    color: var(--muted);
    margin: 0;
  }
  .form__error {
    margin: 0;
    padding: 10px 14px;
    border-radius: 10px;
    background: #fdecea;
    border: 1px solid #f5c2bd;
    color: #8a1c13;
    font-size: 0.95rem;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .map {
    margin-bottom: clamp(64px, 9vw, 120px);
    border-radius: 24px;
    overflow: hidden;
    border: 1px solid var(--line);
  }
  .map iframe {
    display: block;
    width: 100%;
    height: 400px;
    border: 0;
  }
  @media (max-width: 900px) {
    .contact,
    .form__row {
      grid-template-columns: 1fr;
    }
    .map iframe {
      height: 300px;
    }
  }
  @media (max-width: 480px) {
    .form .btn {
      justify-self: stretch;
    }
  }
</style>
